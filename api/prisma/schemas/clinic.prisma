model Clinic {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  name        String
  address     String
  siret       String   @unique
  phone       String
  description String?
  website     String

  speciality             Speciality[]
  veterinarianClinic     VeterinarianClinic[]
  clinicPet              Pet[]
  order                  Orders[]
  clinicProducts         ClinicProduct[]
  secretaryProfile       SecretaryProfile[]
  directorClinicProfiles DirectorClinicProfile[]
  referentClinicProfiles ReferentClinicProfile[]

  @@map("clinic")
}

model Speciality {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  name        String   @unique
  description String

  veterinarianSpeciality VeterinarianProfile[]
  clinicSpeciality       Clinic[]
  mettings               Metting[]

  @@map("speciality")
}

model VeterinarianClinic {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  veterinarianId String
  veterinarian   VeterinarianProfile @relation(fields: [veterinarianId], references: [id], onDelete: Cascade)
  clinicId       String
  clinic         Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  veterinarianClinicAverage VeterinarianClinicAverage[]

  @@map("veterinarian_clinic")
}

enum VeterinarianClinicType {
  RECURRING
  SPECIFIED
  EXECPTION
}

model VeterinarianClinicAverage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  type         VeterinarianClinicType
  dayOfWeek    Int?                   @db.SmallInt
  specificDate DateTime?              @db.Date
  startTime    DateTime               @db.Time(0)
  endTime      DateTime               @db.Time(0)

  veterinarianClinicId String
  vererinarianClinic   VeterinarianClinic @relation(fields: [veterinarianClinicId], references: [id], onDelete: Cascade)

  @@map("veterinarian_clinic_average")
}
