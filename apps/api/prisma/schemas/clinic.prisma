model Clinic {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  name         String
  address      String
  siret        String   @unique
  phone        String
  description  String?
  website      String
  openingHours String?
  lat          Float
  lng          Float

  directorId String                @unique
  director   DirectorClinicProfile @relation(fields: [directorId], references: [id])

  specialities           Speciality[]
  clinicPet              Pet[]
  order                  Order[]
  clinicProducts         ClinicProduct[]
  veterinarianClinics    VeterinarianClinic[]
  secretaryProfile       SecretaryProfile[]
  referentClinicProfiles ReferentClinicProfile[]
  internalMeetings       InternalMeeting[]
  clinicActs             ClinicAct[]
  availabilities         Availability[]
  conversations          Conversation[]
  productRequests ProductRequest[]

  @@map("clinics")
}

enum ClinicRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model ClinicRequest {
  id          String              @id @default(uuid())
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @default(now()) @updatedAt
  status      ClinicRequestStatus @default(PENDING)
  name        String
  address     String
  siret       String
  phone       String
  website     String
  description String?

  directorId String
  director   DirectorClinicProfile @relation(fields: [directorId], references: [id], onDelete: Cascade)

  @@map("clinic_requests")
}

model Speciality {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  name        String   @unique
  description String

  veterinarians VeterinarianProfile[]
  clinics       Clinic[]
  meetings      AnimalMeeting[]

  @@map("specialities")
}

model VeterinarianClinic {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  veterinarianId String
  veterinarian   VeterinarianProfile @relation(fields: [veterinarianId], references: [id], onDelete: Cascade)
  clinicId       String
  clinic         Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  animalMedicalHistoryId String?
  animalMedicalHistory   AnimalMedicalHistory? @relation(fields: [animalMedicalHistoryId], references: [id])

  reviews        Review[]
  animalMeetings AnimalMeeting[]

  @@map("veterinarian_clinics")
}
