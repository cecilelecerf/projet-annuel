model HealthCondition {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  name        String
  description String @db.Text

  petId String
  pet   Pet    @relation(fields: [petId], references: [id])

  ownedPetConditionHealths OwnedPetHealthCondition[]
  foodHealthConditions     FoodHealthCondition[]

  @@map("health_conditions")
}

model OwnedPetHealthCondition {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  notes       String
  diagnosedAt DateTime

  healthConditionId String
  healthCondition   HealthCondition @relation(fields: [healthConditionId], references: [id])
  ownedPetId        String
  ownedPet          OwnedPet        @relation(fields: [ownedPetId], references: [id])
  meetingId         String?
  animalMeeting     AnimalMetting?  @relation(fields: [meetingId], references: [id])
  addedById         String
  addedBy           User            @relation(fields: [addedById], references: [id])

  @@map("owned_pet_health_conditions")
}

enum FoodHealthConditionRecommendation {
  RECOMMENDED
  AVOID
}

model FoodHealthCondition {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  recommendation FoodHealthConditionRecommendation

  foodId            String
  food              Food            @relation(fields: [foodId], references: [id])
  healthConditionId String
  healthContdition  HealthCondition @relation(fields: [healthConditionId], references: [id])

  @@map("food_health_conditions")
}
