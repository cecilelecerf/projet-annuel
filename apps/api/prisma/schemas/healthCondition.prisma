model HealthCondition {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  name        String
  description String @db.Text

  petId String
  pet   Pet    @relation(fields: [petId], references: [id])

  animalConditionHealths AnimalHealthCondition[]
  foodHealthConditions   FoodHealthCondition[]

  @@map("health_conditions")
}

model AnimalHealthCondition {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  notes       String
  diagnosedAt DateTime

  healthConditionId String
  healthCondition   HealthCondition @relation(fields: [healthConditionId], references: [id])
  animalId          String
  animal            Animal          @relation(fields: [animalId], references: [id], onDelete: Cascade)
  meetingId         String?
  animalMeeting     AnimalMeeting?  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  addedById         String
  addedBy           User            @relation(fields: [addedById], references: [id])

  @@map("owned_pet_health_conditions")
}

enum FoodHealthConditionRecommendation {
  RECOMMENDED
  AVOID
}

model FoodHealthCondition {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  recommendation FoodHealthConditionRecommendation

  foodId            String
  food              Food            @relation(fields: [foodId], references: [id])
  healthConditionId String
  healthContdition  HealthCondition @relation(fields: [healthConditionId], references: [id])

  @@map("food_health_conditions")
}
