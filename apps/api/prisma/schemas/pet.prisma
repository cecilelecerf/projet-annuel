enum AnimalStatus {
  ALIVE
  DECEASED
}

model Animal {
  id          String       @id @default(uuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  name        String
  dateOfBirth DateTime
  description String?
  activity    Int?
  status      AnimalStatus @default(ALIVE)

  outdoorAccess Boolean @default(false)
  animalContact Boolean @default(false)

  // Informatif uniquement : la clinique facture toujours le prix plein,
  // le propriétaire se fait rembourser après coup par son assureur.
  hasInsurance          Boolean @default(false)
  insuranceProvider     String?
  insurancePolicyNumber String?

  attendingVeterinarianClinicId String?
  attendingVeterinarianClinic   VeterinarianClinic? @relation(fields: [attendingVeterinarianClinicId], references: [id])

  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  raceId String
  race   Race   @relation(fields: [raceId], references: [id])

  photoId String? @unique
  photo   File?   @relation("AnimalPhoto", fields: [photoId], references: [id], onDelete: SetNull)

  animalVaccine          AnimalVaccine[]
  animalMeeting          AnimalMeeting[]
  foodPets               FoodPet[]
  animalConditionHealths AnimalHealthCondition[]
  animalMedicalHistories AnimalMedicalHistory[]

  @@map("animals")
}

model Pet {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  name      String
  picture   String?

  races            Race[]
  vaccine          Vaccine[]
  clinics          Clinic[]
  veterinarians    VeterinarianProfile[]
  healthConditions HealthCondition[]

  @@map("pets")
}

model Race {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  name      String
  picture   String?

  petId  String
  pet    Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  animal Animal[]

  @@map("races")
}

enum VaccineRuleType {
  MANDATORY
  RECOMMENDED
}

model VaccineCountryRule {
  id      String          @id @default(uuid())
  country String
  minAge  Int
  type    VaccineRuleType

  vaccineId String
  vaccine   Vaccine @relation(fields: [vaccineId], references: [id], onDelete: Cascade)

  @@unique([vaccineId, country, type])
  @@map("vaccine_country_rules")
}

model Vaccine {
  id              String               @id @default(uuid())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @default(now()) @updatedAt
  recommendedAge  Int
  boosterInterval Int
  countryRules    VaccineCountryRule[]

  petId          String
  pet            Pet             @relation(fields: [petId], references: [id], onDelete: Cascade)
  animalVaccines AnimalVaccine[]

  act Act?

  @@map("vaccines")
}
