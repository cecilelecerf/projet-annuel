model Animal {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  name        String
  dateOfBirth DateTime
  description String?
  activity    Int?

  outdoorAccess Boolean @default(false)
  animalContact Boolean @default(false)

  attendingVeterinarianId String?
  attendingVeterinarian   VeterinarianProfile? @relation(fields: [attendingVeterinarianId], references: [id])

  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id])

  raceId String
  race   Race   @relation(fields: [raceId], references: [id])

  animalVaccine          AnimalVaccine[]
  animalMeeting          AnimalMeeting[]
  foodPets               FoodPet[]
  animalConditionHealths AnimalHealthCondition[]
  animalMedicalHistories AnimalMedicalHistory[]

  @@map("animals")
}

model Pet {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  name      String
  picture   String?

  races            Race[]
  vaccine          Vaccine[]
  clinic           Clinic[]
  veterinarian     VeterinarianProfile[]
  healthConditions HealthCondition[]

  @@map("pets")
}

model Race {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  name      String
  picture   String?

  petId  String
  pet    Pet      @relation(fields: [petId], references: [id])
  animal Animal[]

  @@map("races")
}

enum VaccineRuleType {
  MANDATORY
  RECOMMENDED
}

model VaccineCountryRule {
  id      String          @id @default(uuid())
  country String
  minAge  Int
  type    VaccineRuleType

  vaccineId String
  vaccine   Vaccine @relation(fields: [vaccineId], references: [id], onDelete: Cascade)

  @@unique([vaccineId, country, type])
  @@map("vaccine_country_rules")
}

model Vaccine {
  id              String               @id @default(uuid())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @default(now()) @updatedAt
  recommendedAge  Int
  boosterInterval Int
  countryRules    VaccineCountryRule[]

  petId          String
  pet            Pet             @relation(fields: [petId], references: [id])
  animalVaccines AnimalVaccine[]

  act Act?

  @@map("vaccines")
}
