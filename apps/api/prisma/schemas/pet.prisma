model Animal {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  name        String
  dateOfBirth DateTime
  description String?
  activity    Int?

  attendingVeterinarianId String?
  attendingVeterinarian   VeterinarianProfile? @relation(fields: [attendingVeterinarianId], references: [id])

  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id])

  raceId String
  race   Race   @relation(fields: [raceId], references: [id])

  animalVaccine          AnimalVaccine[]
  animalMeeting          AnimalMeeting[]
  foodPets               FoodPet[]
  animalConditionHealths AnimalHealthCondition[]
  animalMedicalHistories AnimalMedicalHistory[]

  @@map("animals")
}

model Pet {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  name      String
  picture   String?

  races            Race[]
  vaccine          Vaccine[]
  clinic           Clinic[]
  veterinarian     VeterinarianProfile[]
  healthConditions HealthCondition[]

  @@map("pets")
}

model Race {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  name      String
  picture   String?

  petId  String
  pet    Pet      @relation(fields: [petId], references: [id])
  animal Animal[]

  @@map("races")
}

model Vaccine {
  id                 String   @id @default(uuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
  name               String
  description        String?
  recommendedAge     Int
  boosterInterval    Int
  mandatoryCountry   Json?
  recommendedCountry Json?

  petId         String
  pet           Pet             @relation(fields: [petId], references: [id])
  animalVaccine AnimalVaccine[]

  @@map("vaccines")
}
