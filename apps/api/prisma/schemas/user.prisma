enum UserRole {
  CLIENT
  SECRETARY
  VETERINARIAN
  DIRECTOR
  REFERANT
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  role      UserRole @default(CLIENT)
  email     String   @unique
  firstname String
  lastname  String
  password  String
  picture   String?

  clientProfile         ClientProfile?
  veterinarianProfile   VeterinarianProfile?
  secretaryProfile      SecretaryProfile?
  directorClinicProfile DirectorClinicProfile?
  referentClinicProfile ReferentClinicProfile?

  refreshTokens               RefreshToken[]
  ownedPetConditionHealths    OwnedPetHealthCondition[]
  conversationMembers         ConversationMember[]
  internalMeetingParticipants InternalMeetingParticipant[]
  meticalVisites              MedicalVisit[]
  availabilities              Availability[]
  adminInternalMeetings       InternalMeeting[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model ClientProfile {
  id          String   @id @default(uuid())
  dateOfBirth DateTime
  address     String?
  phone       String?

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  ownedPet       OwnedPet[]
  clinicProducts ClinicProduct[]
  order          Order[]

  @@map("client_profiles")
}

model VeterinarianProfile {
  id            String  @id @default(uuid())
  licenseNumber String  @unique // rppsNumber
  bio           String?

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  ownedPet                   OwnedPet[]
  animalMeeting              AnimalMeeting[]
  speciality                 Speciality[]
  veterinarianClinic         VeterinarianClinic[]
  pet                        Pet[]
  animalMeetingActPerformers AnimalMeetingActPerformer[]
  hospitalizationReports     HospitalizationReport[]
  prescriptions              Prescription[]
  veterinarianIdentity       VeterinarianIdentity?
  bankingInfo                BankingInfo?

  @@map("veterinarian_profiles")
}

model VeterinarianIdentity {
  id String @id @default(uuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  birthCity       String?
  birthDepartment String?
  birthCountry    String?
  nationality     String?

  inseNumber            String?
  diploma               String?
  diplomaObtainedAt     DateTime?
  rppsNumber            String?
  orderRegisteredAt     DateTime?
  practiceAuthorization Boolean   @default(false)

  proPhone String?

  veterinarianId String              @unique
  veterinarian   VeterinarianProfile @relation(fields: [veterinarianId], references: [id], onDelete: Cascade)

  @@map("veterinarian_identities")
}

model BankingInfo {
  id String @id @default(uuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  iban          String?
  bic           String?
  domiciliation String?
  beneficiary   String?

  veterinarianId String?                @unique
  veterinarian   VeterinarianProfile?   @relation(fields: [veterinarianId], references: [id])
  secretaryId    String?                @unique
  secretary      SecretaryProfile?      @relation(fields: [secretaryId], references: [id])
  referantId     String?                @unique
  referant       ReferentClinicProfile? @relation(fields: [referantId], references: [id])

  @@map("banking_infos")
}

model SecretaryProfile {
  id String @id @default(uuid())

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  clinicId    String
  clinic      Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  bankingInfo BankingInfo?

  @@map("secretary_profiles")
}

model DirectorClinicProfile {
  id String @id @default(uuid())

  user     User   @relation(fields: [id], references: [id], onDelete: Cascade)
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("director_clinic_profiles")
}

model ReferentClinicProfile {
  id String @id @default(uuid())

  user        User         @relation(fields: [id], references: [id], onDelete: Cascade)
  clinicId    String
  clinic      Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  bankingInfo BankingInfo?

  @@map("referent_clinic_profiles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

enum MedicalVisitType {
  HIRING
  PERIODIC
  RETURN
  SPONTANEOUS
  PRE_RETIREMENT
}

enum MedicalVisitResult {
  FIT
  FIT_WITH_RESTRICTIONS
  UNFIT_TEMPORARY
  UNFIT
}

model MedicalVisit {
  id String @id @default(uuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  visitedAt                 DateTime           @default(now())
  newVisitedAt              DateTime?
  result                    MedicalVisitResult
  restrictions              String?
  doctorName                String
  doctorRpps                String
  occupationalHealthService String
  certificateUrl            String

  staffs User[]

  @@map("medical_visits")
}
