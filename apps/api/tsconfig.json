{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "es2023",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@api/*": ["./src/*"],
      "@schemas": ["../../packages/schemas/dist/index.js"],
      "@schemas/*": ["../../packages/schemas/dist/*"]
    }
  },
  "include": ["src/**/*", "prisma/**/*", "prisma.config.ts"],
  "references": [{ "path": "../../packages/schemas" }]
}
