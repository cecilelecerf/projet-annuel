# apps/web/Dockerfile

# ─── Base ──────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.25.0 --activate
WORKDIR /app

# ─── Dépendances ───────────────────────────────────────────────────────────────
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY packages/schemas/package.json ./packages/schemas/
COPY apps/web/package.json ./apps/web/

RUN pnpm install --frozen-lockfile

# ─── Dev ───────────────────────────────────────────────────────────────────────
FROM deps AS dev
ENV NODE_ENV=development

# Le code source arrive via bind mount (docker-compose), pas besoin de COPY ici.
# node_modules (racine + workspaces) est écrasé par des volumes nommés dans compose,
# donc l'install faite dans `deps` sert de contenu initial pour ces volumes.

EXPOSE 5173

# ─── Build ─────────────────────────────────────────────────────────────────────
FROM deps AS build
COPY packages/schemas ./packages/schemas
COPY apps/web ./apps/web
COPY tsconfig.base.json ./

ARG VITE_API_URL=/api
RUN echo "VITE_API_URL=${VITE_API_URL}" > /app/.env.prod

WORKDIR /app/packages/schemas
RUN pnpm build

WORKDIR /app/apps/web
RUN pnpm build

# ─── Production ────────────────────────────────────────────────────────────────
FROM nginx:alpine AS prod
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
